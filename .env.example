# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Render production backend URL for YouTube Music proxy
RENDER_API_URL="https://mymusic-api-siuh.onrender.com"

# Supabase configuration for Authentication, Likes, Library, and Taste Profile persistence
VITE_SUPABASE_URL="https://vguuxzhjocofbcahkwxz.supabase.co"
VITE_SUPABASE_ANON_KEY=""

SUPABASE_URL="https://vguuxzhjocofbcahkwxz.supabase.co/rest/v1/"
SUPABASE_SERVICE_ROLE_KEY=""

# Optional override for API URL (defaults to /api)
VITE_API_URL=""

# Spotify Developer Client ID for Spotify Liked Songs import
VITE_SPOTIFY_CLIENT_ID="2bebd06c23ea41a3814f2a33613a6d88"
